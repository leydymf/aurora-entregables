<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net" type="device"><diagram name="Capas de protección"><mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="dev" value="Dispositivo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7F7F7F;dashed=1;dashPattern=7 4;verticalAlign=top;fontFamily=Times New Roman;fontSize=13;fontStyle=1;fontColor=#000000;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="340" height="380" as="geometry"/></mxCell><mxCell id="c1" value="&lt;b&gt;Capa 1 — Camuflaje&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Fachada de clima, código secreto,&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;sin rastros ni indicios&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0E4E9;strokeColor=#000000;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="95" width="300" height="72" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Capa 2 — Autenticación y sesión&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Credenciales, bloqueo por intentos,&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;cierre automático a los 5 minutos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C7D5E0;strokeColor=#000000;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="300" height="72" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Capa 3 — Cifrado local&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Base de datos y archivos cifrados,&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;llaves en Android Keystore&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5C8D2;strokeColor=#000000;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="285" width="300" height="72" as="geometry"/></mxCell><mxCell id="nube" value="Nube" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7F7F7F;dashed=1;dashPattern=7 4;verticalAlign=top;fontFamily=Times New Roman;fontSize=13;fontStyle=1;fontColor=#000000;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="450" y="120" width="210" height="240" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Capa 4 — Reglas de acceso&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Datos solo de su dueña;&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;contenido solo lectura;&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;administración sin acceso&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;a datos de usuarias&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B5AECB;strokeColor=#000000;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="465" y="155" width="180" height="175" as="geometry"/></mxCell><mxCell id="f1" value="" style="endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;html=1;rounded=0;fontFamily=Times New Roman;fontSize=11;fontStyle=2;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f2" value="" style="endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;html=1;rounded=0;fontFamily=Times New Roman;fontSize=11;fontStyle=2;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relativ